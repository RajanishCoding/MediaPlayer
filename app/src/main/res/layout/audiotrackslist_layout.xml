<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_tracks_view"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_marginVertical="3dp"
    android:paddingVertical="9dp"
    android:paddingHorizontal="15dp"
    android:minHeight="50dp">

    <RadioButton
        android:id="@+id/audioRadioButton"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center_vertical"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Video Info -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audioLinearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/audioRadioButton"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Track Label -->
        <TextView
            android:id="@+id/audioTrackLabel"
            style="@style/TextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Label"
            android:textSize="16sp"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" /> <!-- Set text dynamically in onBindViewHolder -->

        <!-- Track Channel -->
        <TextView
            android:id="@+id/audioTrack_LangChannels"
            style="@style/TextViewStyleVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Language - Channels"
            android:textColor="#D9FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/audioTrack_Unsupported"
            app:layout_constraintTop_toBottomOf="@id/audioTrackLabel" />

        <com.google.android.material.chip.Chip
            android:id="@+id/audioTrack_Unsupported"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingVertical=".1dp"
            app:ensureMinTouchTargetSize="false"
            app:chipMinHeight="0dp"
            app:textStartPadding="0dp"
            app:textEndPadding="0dp"
            android:backgroundTint="#1A5D0F0F"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="#B3B71C1C"
            app:chipCornerRadius="6dp"
            android:text="Unsupported"
            android:textColor="#D9FFFFFF"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/audioTrack_LangChannels"
            android:visibility="visible"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

