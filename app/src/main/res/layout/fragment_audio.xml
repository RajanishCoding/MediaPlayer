<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Audio.AudioFragment"
    style="@style/FilesListBG" >

    <!-- Custom Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ToolbarTitleStyle"
                android:text="Audio"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="20dp" />

            <ImageButton
                android:id="@+id/search_button"
                style="@style/ToolbarIconsStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:layout_toStartOf="@id/menu_button"
                android:background="@drawable/ripple_effect"
                android:contentDescription="TODO"
                android:padding="3dp"
                android:src="@drawable/baseline_search_24"
                android:tooltipText="Search"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/menu_button"
                style="@style/ToolbarIconsStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:background="@drawable/ripple_effect"
                android:contentDescription="TODO"
                android:padding="3dp"
                android:src="@drawable/baseline_more_vert_24"
                android:tooltipText="More Options"
                tools:ignore="TouchTargetSizeCheck" />
        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_sel"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/toolbarSel_backB"
                style="@style/ToolbarIconsStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/ripple_effect"
                android:contentDescription="TODO"
                android:padding="3dp"
                android:src="@drawable/baseline_arrow_back_24"
                android:tooltipText="Search"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/toolbarSel_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ToolbarTitleStyle"
                android:text="2/3 selected"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="normal"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/toolbarSel_backB"
                android:layout_marginStart="20dp" />

            <ImageButton
                android:id="@+id/toolbarSel_playB"
                style="@style/ToolbarIconsStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:layout_toStartOf="@id/toolbarSel_selB"
                android:background="@drawable/ripple_effect"
                android:contentDescription="TODO"
                android:padding="3dp"
                android:src="@drawable/media3_icon_play"
                android:tooltipText="Search"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/toolbarSel_selB"
                style="@style/ToolbarIconsStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:background="@drawable/ripple_effect"
                android:contentDescription="TODO"
                android:padding="3dp"
                android:src="@drawable/media3_icon_check_circle_unfilled"
                android:tooltipText="More Options"
                tools:ignore="TouchTargetSizeCheck" />
        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>



    <TextView
        android:id="@+id/found_text_audio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No audio files found"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        android:visibility="gone" />


    <!-- SwipeRefreshLayout with RecyclerView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent" >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/bottomBar_sel"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        style="@style/NavBarStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/renameB_sel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Rename"
            android:backgroundTint="@color/btn_bottom"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:icon="@drawable/round_rename_outline_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/selector_btn_bottom" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteB_sel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Delete"
            android:backgroundTint="@color/btn_bottom"
            android:insetTop="0dp"
            app:cornerRadius="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/round_delete_forever"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/selector_btn_bottom" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareB_sel"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Share"
            android:backgroundTint="@color/btn_bottom"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:icon="@drawable/round_share"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/selector_btn_bottom" />

    </LinearLayout>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/MenuContainer_Audio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/shape_more_section"
        android:visibility="gone"
        android:layout_margin="8dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="5dp"
        android:outlineProvider="none"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/layoutTitle"
                    style="@style/ToolbarTitleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Layout"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/layoutViewToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:padding="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true"
                    app:layout_constraintTop_toBottomOf="@id/layoutTitle">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/layout_list"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:iconGravity="top"
                        app:icon="@drawable/rounded_lists_24"
                        android:backgroundTint="@color/selector_toggle_btn"
                        android:text="List Layout" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/layout_grid"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:iconGravity="top"
                        app:icon="@drawable/rounded_grid_view_24"
                        android:backgroundTint="@color/selector_toggle_btn"
                        android:text="Grid Layout"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sortContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/layoutContainer">

                <TextView
                    android:id="@+id/sortTitle"
                    style="@style/ToolbarTitleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10px"
                    android:text="Sort"
                    android:textAlignment="center" android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sortLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@id/sortTitle">

                    <TableLayout
                        android:id="@+id/sortTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:stretchColumns="*"
                        app:layout_constraintTop_toTopOf="parent">

                        <TableRow
                            android:paddingVertical="4dp"
                            android:layout_width="match_parent"
                            >

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sort_byName"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginRight="5dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                android:textColor="@color/text_color"
                                android:text="Name" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sort_byDate"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginRight="5dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMaxTextSize="14sp"
                                android:text="Date Added"
                                android:textColor="@color/text_color" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sort_bySize"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                android:textColor="@color/text_color"
                                android:text="Size" />
                        </TableRow>

                        <TableRow
                            android:paddingVertical="4dp"
                            android:layout_width="match_parent">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sort_byLength"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginRight="5dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMaxTextSize="14sp"
                                android:textColor="@color/text_color"
                                android:text="Duration" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sort_byResol"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginRight="5dp"
                                android:backgroundTint="@color/selector_toggle_btn"
                                android:checkable="true"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMaxTextSize="14sp"
                                android:text="Resolution"
                                android:textColor="@color/text_color" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sort_byFps"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMaxTextSize="14sp"
                                android:textColor="@color/text_color"
                                android:text="Frame Rate" />
                        </TableRow>

                    </TableLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/sortOrderToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:padding="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true"
                        app:layout_constraintTop_toBottomOf="@id/sortTable">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sort_Asc"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            app:icon="@drawable/rounded_arrow_downward_alt_24"
                            android:backgroundTint="@color/selector_toggle_btn"
                            android:text="Ascending"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sort_Desc"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/rounded_arrow_upward_alt_24"
                            android:backgroundTint="@color/selector_toggle_btn"
                            android:text="Descending" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/detailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/sortContainer">

                <TextView
                    android:id="@+id/detailsTitle"
                    style="@style/ToolbarTitleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Details"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/detailsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@id/detailsTitle">


                    <TableLayout
                        android:id="@+id/detailsTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:stretchColumns="*"
                        app:layout_constraintTop_toTopOf="parent">

                        <TableRow
                            android:paddingVertical="4dp"
                            android:layout_width="wrap_content">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/details_Date"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginRight="5dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                android:textColor="@color/text_color"
                                android:text="Date Added" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/details_Dur"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginRight="5dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                android:textColor="@color/text_color"
                                android:text="Duration" />

                        </TableRow>

                        <TableRow
                            android:paddingVertical="4dp"
                            android:layout_width="match_parent">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/details_Path"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginRight="5dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                android:textColor="@color/text_color"
                                android:text="Path" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/details_Size"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:checkable="true"
                                android:backgroundTint="@color/selector_toggle_btn"
                                android:textColor="@color/text_color"
                                android:text="Size" />

                        </TableRow>

                    </TableLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/moreContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/detailsContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/more_dur"
                        style="@style/ButtonStyleToggle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:paddingStart="15dp"
                        android:textAlignment="textStart"
                        android:text="Display Duration over Thumbnail" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="30dp"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/moreContainer">

                <Button
                    android:id="@+id/buttonCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:text="Cancel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/buttonApply"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Apply"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </LinearLayout>

<!--            <Button-->
<!--                android:id="@+id/buttonApply_Audio"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="10dp"-->
<!--                android:text="Apply Changes"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintTop_toBottomOf="@id/sortContainer" />-->

<!--            <Button-->
<!--                android:id="@+id/buttonCancel_Audio"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="8dp"-->
<!--                android:text="Cancel"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintTop_toBottomOf="@id/buttonApply_Audio" />-->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/Play_Last"
        style="@style/ButtonStyleVariant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="Play_Last"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:fabCustomSize="60dp"
        app:maxImageSize="35dp"
        app:srcCompat="@drawable/media3_icon_play"
        app:tint="#FFFFFF"
        app:borderWidth="0dp" />


</androidx.constraintlayout.widget.ConstraintLayout>