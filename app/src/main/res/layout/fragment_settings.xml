<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Settings.SettingsFragment"
    style="@style/FilesListBG">

    <!-- Custom Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ToolbarTitleStyle"
                android:text="Settings"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="20dp" />

            <ImageButton
                android:id="@+id/search_button"
                style="@style/ToolbarIconsStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:layout_toStartOf="@id/menu_button"
                android:background="@drawable/ripple_effect"
                android:contentDescription="TODO"
                android:padding="3dp"
                android:src="@drawable/baseline_search_24"
                android:tooltipText="Search"
                tools:ignore="TouchTargetSizeCheck"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/menu_button"
                style="@style/ToolbarIconsStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:background="@drawable/ripple_effect"
                android:contentDescription="TODO"
                android:padding="3dp"
                android:src="@drawable/baseline_more_vert_24"
                android:tooltipText="More Options"
                tools:ignore="TouchTargetSizeCheck" />
        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/settings_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="5dp"
        android:checked="true"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbar" >

        <Switch
            android:id="@+id/mode_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="15dp"
            android:text="Dark Mode"
            android:checked="true"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            tools:ignore="UseSwitchCompatOrMaterialXml"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="10dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?attr/materialButtonOutlinedStyle"
                android:backgroundTint="@color/selector_theme_btn"
                app:icon="@drawable/day_night_3"
                app:iconGravity="top"
                app:iconTint="@null"
                app:iconSize="30dp"
                app:iconPadding="-2dp"
                android:text="Dynamic"
                android:textColor="@color/text_color"
                app:cornerRadius="10dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?attr/materialButtonOutlinedStyle"
                android:backgroundTint="@color/selector_theme_btn"
                app:icon="@drawable/light"
                app:iconGravity="top"
                app:iconTint="@null"
                app:iconSize="30dp"
                app:iconPadding="-2dp"
                android:text="Light"
                android:textColor="@color/text_color"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?attr/materialButtonOutlinedStyle"
                android:backgroundTint="@color/selector_theme_btn"
                app:icon="@drawable/night_1"
                app:iconGravity="top"
                app:iconTint="@null"
                app:iconSize="30dp"
                app:iconPadding="-2dp"
                android:text="Dark"
                android:textColor="@color/text_color"
                app:cornerRadius="10dp"
                />

        </com.google.android.material.button.MaterialButtonToggleGroup>
        
        <View
            android:layout_width="match_parent"
            android:layout_height=".8dp"
            android:background="@color/divider_color"
            android:layout_marginHorizontal="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"/>

        <include
            android:id="@+id/playerSetting"
            layout="@layout/item_layout_settings"/>

        <include
            android:id="@+id/audioSetting"
            layout="@layout/item_layout_settings"/>

        <include
            android:id="@+id/subtitleSetting"
            layout="@layout/item_layout_settings"/>

        <include
            android:id="@+id/listSetting"
            layout="@layout/item_layout_settings"/>

        <include
            android:id="@+id/systemSetting"
            layout="@layout/item_layout_settings"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainerSetting"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


</androidx.constraintlayout.widget.ConstraintLayout>